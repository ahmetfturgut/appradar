    "info": {
      "title": "App Store & Google Play Scraper API | Reviews, Charts, Data",
      "description": "Scrape App Store and Google Play apps and reviews in one schema: $0.18 per 1,000 apps and $0.025 per 1,000 reviews on the free plan. App Store data and Google Play data: ratings, installs, developer pages, App Store top charts, several countries per run, only-new-reviews mode. No login.",
      "version": "0.2",
      "x-build-id": "Jv44m9YSKPnrplU1T"
    },

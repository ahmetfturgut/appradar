    "components": {
      "schemas": {
        "inputSchema": {
          "type": "object",
          "properties": {
            "apps": {
              "title": "Apps",
              "maxItems": 500,
              "type": "array",
              "description": "Apps to read, mixed freely: an App Store URL (e.g. 'https://apps.apple.com/us/app/spotify-music-and-podcasts/id324684580'), an App Store ID ('324684580' or 'id324684580'), a Google Play URL (e.g. 'https://play.google.com/store/apps/details?id=com.spotify.music') or an Android package name ('com.spotify.music'). A country in the URL (e.g. /gb/) is used for that app.",
              "default": [],
              "items": {
                "type": "string"
              }
            },
            "maxReviewsPerApp": {
              "title": "Reviews per app",
              "minimum": 0,
              "maximum": 500,
              "type": "integer",
              "description": "How many reviews to return for each app and country, e.g. 100; 0 = app details only. The App Store gives up to 500 per app and country; Google Play's public app page shows about 20 per app and language.",
              "default": 0
            },
            "developers": {
              "title": "Developer pages",
              "maxItems": 500,
              "type": "array",
              "description": "Every app of a developer, e.g. 'https://apps.apple.com/us/developer/spotify/id324684583', 'https://play.google.com/store/apps/developer?id=Spotify+AB' or 'https://play.google.com/store/apps/dev?id=5700313618786177705'.",
              "default": [],
              "items": {
                "type": "string"
              }
            },
            "appStoreCharts": {
              "title": "App Store top charts",
              "type": "array",
              "description": "App Store top charts to read, e.g. ['top-free']: each app comes with its rank; an app on several of your charts is one row whose chart_ranks lists every chart and rank (up to 100). Google Play's charts are not on any public page that robots.txt allows, so they are not offered.",
              "items": {
                "type": "string",
                "enum": [
                  "top-free",
                  "top-paid",
                  "top-grossing"
                ],
                "enumTitles": [
                  "Top free",
                  "Top paid",
                  "Top grossing"
                ]
              },
              "default": []
            },
            "chartGenre": {
              "title": "Chart category",
              "enum": [
                "",
                "6014",
                "6000",
                "6017",
                "6016",
                "6015",
                "6023",
                "6013",
                "6012",
                "6020",
                "6011",
                "6010",
                "6009",
                "6008",
                "6007",
                "6006",
                "6024",
                "6005",
                "6004",
                "6003",
                "6002",
                "6001",
                "6018",
                "6027",
                "6026",
                "6021"
              ],
              "type": "string",
              "description": "App Store category for the charts, e.g. Games; 'All categories' = the overall chart.",
              "default": ""
            },
            "countries": {
              "title": "Countries",
              "maxItems": 50,
              "type": "array",
              "description": "Two-letter store countries, e.g. ['us', 'gb', 'de']. Each app ID, package name, developer page and chart is read in every country listed; prices, ratings and reviews differ per country.",
              "default": [
                "us"
              ],
              "items": {
                "type": "string"
              }
            },
            "maxAppsPerList": {
              "title": "Apps per chart or developer",
              "minimum": 1,
              "maximum": 200,
              "type": "integer",
              "description": "Most apps to return from each chart (up to 100) or developer page, e.g. 50.",
              "default": 50
            },
            "language": {
              "title": "Google Play language",
              "type": "string",
              "description": "Language code for Google Play pages and the reviews they show, e.g. 'en', 'de', 'pt-BR'. The App Store answers in each country's own store language.",
              "default": "en"
            },
            "reviewSort": {
              "title": "App Store review order",
              "enum": [
                "mostrecent",
                "mosthelpful"
              ],
              "type": "string",
              "description": "Which App Store reviews come first: the most recent or the most helpful.",
              "default": "mostrecent"
            },
            "onlyNewReviews": {
              "title": "Only new reviews",
              "type": "boolean",
              "description": "Return only reviews not returned by your previous runs of the same app, in any country (one memory per app and Google Play language). The first run returns everything; schedule it daily to get each day's new reviews.",
              "default": false
            },
            "stateKey": {
              "title": "Tracking name (optional)",
              "type": "string",
              "description": "Name for the 'previous runs' memory used by 'Only new reviews', e.g. 'my-app-daily'. Leave empty to share one memory per app across all your runs."
            },
            "proxyConfiguration": {
              "title": "Proxy",
              "type": "object",
              "description": "Apify Proxy; the default datacenter group works for both stores.",
              "default": {
                "useApifyProxy": true
              }
            },
            "slackWebhookUrl": {
              "title": "Slack webhook URL (optional)",
              "type": "string",
              "description": "After each run, post a short digest to Slack: how many results were saved (new reviews only when 'Only new reviews' is on) and the top 10, e.g. https://hooks.slack.com/services/T000/B000/XXXX. Nothing is posted when the run saved nothing. Leave empty to skip."
            },
            "webhookUrl": {
              "title": "Webhook URL (optional)",
              "type": "string",
              "description": "After each run, POST the same digest as JSON (actor, newOnly, count, items = top 10 results, runUrl, text) to any URL, e.g. a Zapier, Make or n8n webhook. Nothing is sent when the run saved nothing. Leave empty to skip."
            }
          }
        },

    "components": {
      "schemas": {
        "inputSchema": {
          "type": "object",
          "required": [
            "keywords"
          ],
          "properties": {
            "keywords": {
              "title": "Keywords",
              "type": "array",
              "description": "Keywords to analyze (max 100 per run). Each keyword produces ranking rows and, optionally, suggestion and popularity rows.",
              "items": {
                "type": "string"
              }
            },
            "store": {
              "title": "Store",
              "enum": [
                "ios",
                "android",
                "both"
              ],
              "type": "string",
              "description": "Which app store(s) to check.",
              "default": "ios"
            },
            "country": {
              "title": "Country",
              "type": "string",
              "description": "Two-letter country code of the storefront (e.g. us, gb, de). Rankings work everywhere; popularity and difficulty cover Sonar's 72 keyword-research markets.",
              "default": "us"
            },
            "appIds": {
              "title": "Track specific apps (optional)",
              "type": "array",
              "description": "App IDs whose rank you want for each keyword \u2014 numeric track IDs for iOS (e.g. 6479523618), package names for Android (e.g. com.example.app). Leave empty to get the top-N ranked apps per keyword instead.",
              "default": [],
              "items": {
                "type": "string"
              }
            },
            "topN": {
              "title": "Top N apps per keyword",
              "minimum": 1,
              "maximum": 50,
              "type": "integer",
              "description": "How many top-ranked apps to return per keyword when no specific apps are tracked.",
              "default": 10
            },
            "includeSuggestions": {
              "title": "Include keyword suggestions",
              "type": "boolean",
              "description": "Fetch autocomplete/search suggestions for each keyword (great for keyword discovery).",
              "default": false
            },
            "includePopularity": {
              "title": "Include search popularity & difficulty",
              "type": "boolean",
              "description": "Fetch search popularity (Apple's own Search Popularity on iOS) and keyword difficulty for each keyword \u2014 premium, powered by Sonar (trysonar.app). Keywords that can't be served in the run are returned with an error and not charged.",
              "default": true
            }
          }
        },

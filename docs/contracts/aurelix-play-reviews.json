    "components": {
      "schemas": {
        "inputSchema": {
          "type": "object",
          "properties": {
            "apps": {
              "title": "Apps",
              "maxItems": 500,
              "type": "array",
              "description": "Google Play apps to read: a Google Play URL (e.g. 'https://play.google.com/store/apps/details?id=com.spotify.music') or an Android package name ('com.spotify.music'). Paste several, one per line.",
              "items": {
                "type": "string"
              }
            },
            "maxReviewsPerApp": {
              "title": "Reviews per app",
              "minimum": 1,
              "maximum": 100000,
              "type": "integer",
              "description": "Most reviews to return for each app and country, e.g. 5,000. The run pages through the app's reviews until it has this many or the list ends.",
              "default": 100
            },
            "sort": {
              "title": "Review order",
              "enum": [
                "newest",
                "most_relevant",
                "rating"
              ],
              "type": "string",
              "description": "Which reviews come first: newest, most relevant (Google Play's default) or by rating.",
              "default": "newest"
            },
            "stars": {
              "title": "Star rating filter",
              "enum": [
                "",
                "1",
                "2",
                "3",
                "4",
                "5"
              ],
              "type": "string",
              "description": "Return only reviews with this star rating, e.g. 1 star for complaints; 'All ratings' = no filter.",
              "default": ""
            },
            "language": {
              "title": "Language",
              "type": "string",
              "description": "Language of the reviews, e.g. 'en', 'de', 'pt-BR' or 'Spanish'. Google Play shows each app's reviews per language.",
              "default": "en"
            },
            "countries": {
              "title": "Countries",
              "maxItems": 20,
              "type": "array",
              "description": "Two-letter Google Play countries, e.g. ['us', 'gb']. Each app is read in every country listed; a review already returned for another country in the same run is not returned or charged again.",
              "default": [
                "us"
              ],
              "items": {
                "type": "string"
              }
            },
            "onlyNewReviews": {
              "title": "Only new reviews",
              "type": "boolean",
              "description": "Return only reviews posted (or edited) since your previous run of the same apps, language and star filter, in each country; reviews already returned are never returned again. Reads newest first whatever 'Review order' says. The first run returns up to 'Reviews per app'; schedule it daily to get each day's new reviews.",
              "default": false
            },
            "stateKey": {
              "title": "Tracking name (optional)",
              "type": "string",
              "description": "Name for the 'previous runs' memory used by 'Only new reviews', e.g. 'my-app-daily'. Leave empty to key the memory from the apps, language and star filter."
            },
            "proxyConfiguration": {
              "title": "Proxy",
              "type": "object",
              "description": "Apify Proxy; the default datacenter group works for Google Play.",
              "default": {
                "useApifyProxy": true
              }
            },
            "slackWebhookUrl": {
              "title": "Slack webhook URL (optional)",
              "type": "string",
              "description": "After each run, post a short digest to Slack: how many results were saved (new reviews only when 'Only new reviews' is on) and the top 10, e.g. https://hooks.slack.com/services/T000/B000/XXXX. Nothing is posted when the run saved nothing. Leave empty to skip."
            },
            "webhookUrl": {
              "title": "Webhook URL (optional)",
              "type": "string",
              "description": "After each run, POST the same digest as JSON (actor, newOnly, count, items = top 10 results, runUrl, text) to any URL, e.g. a Zapier, Make or n8n webhook. Nothing is sent when the run saved nothing. Leave empty to skip."
            }
          }
        },

      "title": "Google Play Reviews Scraper | Android App Reviews",
      "description": "Scrape Google Play reviews of any Android app at $0.05 per 1,000 reviews, less on paid plans. Thousands per app, newest, most relevant or by rating, star filter, any language and country: rating, text, date, version, thumbs-up, developer reply. No login.",
      "version": "0.1",
      "x-build-id": "w3YTTu8Bd7IY6z2uU"
    },

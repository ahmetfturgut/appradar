    "components": {
      "schemas": {
        "inputSchema": {
          "type": "object",
          "properties": {
            "mode": {
              "title": "Mode",
              "enum": [
                "search",
                "details",
                "charts"
              ],
              "type": "string",
              "description": "search = find apps by keyword (up to 200 results per iOS term, about 30 per Play term). details = look up specific apps by id, URL, bundle id or package name. charts = today's top charts.",
              "default": "search"
            },
            "store": {
              "title": "Store",
              "enum": [
                "both",
                "ios",
                "play"
              ],
              "type": "string",
              "description": "Which store to query. both interleaves the two stores so a small maxItems does not starve one of them.",
              "default": "both"
            },
            "searchTerms": {
              "title": "Search terms",
              "type": "array",
              "description": "One keyword per line, e.g. todo, photo editor, meditation. iOS returns up to 200 results per term; Google Play returns about 30 per term and has no paging. Search mode only.",
              "items": {
                "type": "string"
              }
            },
            "appIds": {
              "title": "Apps",
              "type": "array",
              "description": "Apps to look up when mode is details. One per line: apps.apple.com URLs, numeric App Store ids (id389801252 or 389801252), Apple bundle ids (com.burbn.instagram), play.google.com URLs or Play package names (com.instagram.android). With store=both a bare bundle id or package name is tried against both stores.",
              "items": {
                "type": "string"
              }
            },
            "chartCollection": {
              "title": "Chart",
              "enum": [
                "topFree",
                "topPaid",
                "topGrossing"
              ],
              "type": "string",
              "description": "topFree and topPaid work on both stores. topGrossing is iOS-only on Apple's legacy feed; Google Play has its own grossing chart.",
              "default": "topFree"
            },
            "iosGenreId": {
              "title": "iOS genre id (optional)",
              "pattern": "^(\\s*\\d{3,6}\\s*)?$",
              "type": "string",
              "description": "Apple genre id to filter the iOS chart, e.g. 6014 for Games or 6007 for Productivity. Genre filtering works on the iOS legacy iTunes feed only; Google Play uses playCategory instead."
            },
            "playCategory": {
              "title": "Play category",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{1,40}$",
              "type": "string",
              "description": "Google Play chart category id: APPLICATION (default), GAME, GAME_ACTION, GAME_ARCADE, PRODUCTIVITY, TOOLS and so on.",
              "default": "APPLICATION"
            },
            "country": {
              "title": "Country",
              "pattern": "^(\\s*[A-Za-z]{2}\\s*)?$",
              "type": "string",
              "description": "Two-letter storefront: us, gb, de, my, sg, in, jp. Prices and currencies follow the storefront. uk is accepted as an alias for gb.",
              "default": "us"
            },
            "language": {
              "title": "Language",
              "pattern": "^(\\s*[A-Za-z]{2,3}([-_][A-Za-z0-9]{2,4})?\\s*)?$",
              "type": "string",
              "description": "Language code for Google Play pages, e.g. en, de, pt-BR. iOS text follows the storefront. Each row carries the language the run used.",
              "default": "en"
            },
            "fullDetails": {
              "title": "Full details for Play search and chart rows",
              "type": "boolean",
              "description": "Google Play search and chart listings lack rating count, review count, version, update date and developer contacts. Turn this on to fetch each app's details page and fill them in (one extra request per app, still one app event). iOS rows are always full.",
              "default": false
            },
            "maxItems": {
              "title": "Max items",
              "minimum": 1,
              "maximum": 5000,
              "type": "integer",
              "description": "Global cap on delivered app rows across all terms and stores (1-5000). The default of 50 costs about $0.015. Error rows are never charged and do not count against this cap.",
              "default": 50
            },
            "proxy": {
              "title": "Proxy configuration",
              "type": "object",
              "description": "Off by default. Both stores answer direct requests from Apify; turn Apify Proxy on only if your runs get blocked. When it is on, a failed proxy setup fails the request instead of silently going direct.",
              "default": {
                "useApifyProxy": false
              }
            }
          }
        },

    "components": {
      "schemas": {
        "inputSchema": {
          "type": "object",
          "properties": {
            "appleCharts": {
              "title": "Apple top charts",
              "type": "array",
              "description": "Official App Store charts to read (up to 100 apps each).",
              "items": {
                "type": "string",
                "enum": [
                  "top-free",
                  "top-paid",
                  "top-grossing",
                  "top-free-ipad",
                  "top-paid-ipad",
                  "top-grossing-ipad",
                  "new-apps",
                  "new-free-apps",
                  "new-paid-apps"
                ]
              }
            },
            "appleGenres": {
              "title": "Apple chart categories",
              "type": "array",
              "description": "Category IDs. Leave empty for all apps. Common: 6014 Games, 6015 Finance, 6013 Health & Fitness, 6007 Productivity, 6017 Education, 6012 Lifestyle, 6016 Entertainment, 6008 Photo & Video, 6005 Social Networking, 6024 Shopping, 6003 Travel, 6000 Business, 6002 Utilities, 6023 Food & Drink, 6011 Music, 6004 Sports, 6009 News, 6020 Medical.",
              "items": {
                "type": "string"
              }
            },
            "playCharts": {
              "title": "Google Play top charts",
              "type": "array",
              "description": "Google Play charts to read (up to 100 apps each), the same lists the Play Store website shows.",
              "items": {
                "type": "string",
                "enum": [
                  "top-free",
                  "top-paid",
                  "top-grossing"
                ]
              }
            },
            "playCategories": {
              "title": "Google Play chart categories",
              "type": "array",
              "description": "Category IDs. Default APPLICATION (all apps). Common: GAME, GAME_PUZZLE, GAME_ACTION, GAME_CASUAL, COMMUNICATION, SOCIAL, PRODUCTIVITY, FINANCE, HEALTH_AND_FITNESS, EDUCATION, ENTERTAINMENT, SHOPPING, TRAVEL_AND_LOCAL, TOOLS, MUSIC_AND_AUDIO, PHOTOGRAPHY.",
              "items": {
                "type": "string"
              }
            },
            "chartLimit": {
              "title": "Apps per chart",
              "minimum": 1,
              "maximum": 100,
              "type": "integer",
              "description": "How many apps to read from each chart (Apple and Google Play serve up to 100).",
              "default": 100
            },
            "trackRankChanges": {
              "title": "Track rank changes",
              "type": "boolean",
              "description": "Remember each chart's ranks in a named key-value store in your account, so the next run adds previousRank, rankChange (+ = moved up) and isNewInChart to every app. Schedule it daily to see which apps are climbing.",
              "default": true
            },
            "searchTerms": {
              "title": "Search terms",
              "type": "array",
              "description": "Keywords to search, e.g. \"habit tracker\". Results keep the store's order (searchRank).",
              "items": {
                "type": "string"
              }
            },
            "searchStores": {
              "title": "Stores to search",
              "type": "array",
              "description": "Which stores the search terms are run on.",
              "items": {
                "type": "string",
                "enum": [
                  "appStore",
                  "googlePlay"
                ]
              },
              "default": [
                "appStore",
                "googlePlay"
              ]
            },
            "searchLimit": {
              "title": "Results per search",
              "minimum": 1,
              "maximum": 200,
              "type": "integer",
              "description": "How many results to keep for each search term, in store order.",
              "default": 30
            },
            "apps": {
              "title": "Specific apps",
              "type": "array",
              "description": "App Store or Google Play URLs, Apple numeric IDs or Android package names.",
              "items": {
                "type": "string"
              }
            },
            "countries": {
              "title": "Countries",
              "type": "array",
              "description": "Two-letter store countries, e.g. us, gb, de, br. Each country is a separate set of results.",
              "default": [
                "us"
              ],
              "items": {
                "type": "string"
              }
            },
            "language": {
              "title": "Language",
              "type": "string",
              "description": "Language code for the results, e.g. en, en-US, de, es.",
              "default": "en"
            },
            "includeDescription": {
              "title": "Include full description and release notes",
              "type": "boolean",
              "description": "Adds the long text fields. Off keeps the output small.",
              "default": false
            },
            "maxConcurrency": {
              "title": "Max concurrency",
              "minimum": 1,
              "maximum": 20,
              "type": "integer",
              "description": "How many pages to fetch in parallel. Lower it if you see blocks.",
              "default": 5
            },
            "proxyConfiguration": {
              "title": "Proxy",
              "type": "object",
              "description": "Proxy used for the requests. The default works for most runs.",
              "default": {
                "useApifyProxy": true
              }
            },
            "historyStoreName": {
              "title": "History store name",
              "type": "string",
              "description": "Use different names to keep separate histories.",
              "default": "app-chart-history"
            }
          }
        },

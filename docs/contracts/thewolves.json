            },
            "deliverMaxItems": {
              "title": "Max records to deliver \u2014 perPost only (optional)",
              "minimum": 1,
              "type": "integer",
              "description": "Cap on how many records perPost mode writes to the connector; ignored in summary mode. Leave empty to deliver everything scraped."
            }

# Gerçek anahtarları bu dosyaya eklemeyin. .env.local kullanın.
APIFY_TOKEN=
# Kullanıcı tarafından onaylanan toplam POC tüketim sınırı, USD.
POC_LIMIT_USD=5
# Gerçek çalışmayı açmak için ayrı olarak true yapılır; varsayılan dry-run.
APIFY_COLLECTION_ENABLED=false
# POC kapsamında saklama/inceleme hakkı doğrulanmadan canlı çekim açılmaz.
POC_DATA_USE_CONFIRMED=false
# POC tamamlanmadan aylık üretim toplaması açılmaz.
MONTHLY_LIMIT_USD=
DAILY_LIMIT_USD=

# Kalıcılık (T4–T7) yalnızca sunucuda kullanır; NEXT_PUBLIC_ ile yayınlamayın.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Okuma sunumu: ticari haklar doğrulanmadan kapalı kalır (true yapılmaz).
APPRADAR_STORE_MEDIA_ENABLED=false
APPRADAR_STORE_DESCRIPTION_ENABLED=false
APPRADAR_REVIEW_CONTENT_ENABLED=false

# Yalnızca NODE_ENV=development iken sentetik UI. Production bu bayrağı yok sayar.
APPRADAR_DEMO_MODE=false

# Gerçek anahtarları bu dosyaya eklemeyin. .env.local kullanın.
APIFY_TOKEN=
# Kullanıcı tarafından onaylanan toplam POC tüketim sınırı, USD.
POC_LIMIT_USD=5
# Gerçek çalışmayı açmak için ayrı olarak true yapılır; varsayılan dry-run.
APIFY_COLLECTION_ENABLED=false
# Third-party rights status: verified | unconfirmed | prohibited (required for paid collection).
# verified = documented provider+store basis; unconfirmed = outstanding legal risk; prohibited = hard block.
APPRADAR_THIRD_PARTY_RIGHTS_STATUS=
# Verified third-party usage only. Never set true to mean owner/operator approval.
# Valid solely when APPRADAR_THIRD_PARTY_RIGHTS_STATUS=verified.
POC_DATA_USE_CONFIRMED=false
# Internal pilot (unconfirmed path): operator product approval — not a third-party licence.
APPRADAR_INTERNAL_PILOT_OPERATOR_APPROVAL=false
# Separate explicit acceptance of unconfirmed-rights risk before bounded internal collection.
APPRADAR_INTERNAL_PILOT_UNCONFIRMED_RISK_ACCEPTED=false
# Unconfirmed pilot scope: b43-details (default) | b45-productivity. Missing → b43-details.
APPRADAR_INTERNAL_PILOT_SCOPE=
# B4.5 Productivity expanded provider/store scope (required only when SCOPE=b45-productivity).
# Separate from B4.3 approvals; not a third-party licence.
APPRADAR_INTERNAL_PILOT_B45_PRODUCTIVITY_OPERATOR_APPROVAL=false
APPRADAR_INTERNAL_PILOT_B45_PRODUCTIVITY_UNCONFIRMED_RISK_ACCEPTED=false
# Public commercial display authorization (fail-closed; distinct from development pilot).
APPRADAR_PUBLIC_COMMERCIAL_DISPLAY_AUTHORIZED=false
# Internal development media display (NODE_ENV=development only). Not a third-party licence.
APPRADAR_INTERNAL_MEDIA_OPERATOR_APPROVAL=false
APPRADAR_INTERNAL_MEDIA_UNCONFIRMED_RISK_ACCEPTED=false
# POC tamamlanmadan aylık üretim toplaması açılmaz.
MONTHLY_LIMIT_USD=
DAILY_LIMIT_USD=

# Kalıcılık (T4–T7) yalnızca sunucuda kullanır; NEXT_PUBLIC_ ile yayınlamayın.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Okuma sunumu: kind flags require a scope (internal media auth in development, or public commercial).
# Legacy APPRADAR_STORE_MEDIA_ENABLED is ignored and must not be used.
APPRADAR_STORE_ICONS_ENABLED=false
APPRADAR_STORE_SCREENSHOTS_ENABLED=false
APPRADAR_STORE_DESCRIPTION_ENABLED=false
APPRADAR_REVIEW_CONTENT_ENABLED=false

# Yalnızca NODE_ENV=development iken sentetik UI. Production bu bayrağı yok sayar.
APPRADAR_DEMO_MODE=false

# Retention cleanup (src/lib/retention/cli.ts) is a dry run unless this is true, --execute is passed
# and the policy file carries an approval. Nothing schedules it.
RETENTION_CLEANUP_EXECUTION=false

# Production only (required there, ignored in development): the ref of the ONE Supabase project this
# deployment may use, i.e. <ref> in https://<ref>.supabase.co. Both Supabase URLs must match it.
# In production the app answers 503 until this file's server and public values are complete and valid,
# and while APPRADAR_DEMO_MODE or any collection/retention flag is true. See docs/PRODUCTION.md.
APPRADAR_SUPABASE_PROJECT_REF=
# Search indexing stays off (noindex metadata + X-Robots-Tag) unless exactly "true". Set only when a public
# launch is approved, then rebuild. Not access control. See docs/PRODUCTION.md §13.
APPRADAR_PUBLIC_INDEXING_APPROVED=
# Operator shell only: the ref of the DEVELOPMENT project. Collection writes, retention --execute and paid
# tools/ runs refuse unless SUPABASE_URL is exactly that project. Never set it to a production ref.
APPRADAR_DEVELOPMENT_PROJECT_REF=
# Operator shell only, for src/lib/migrate/cli.ts. Never commit it or set it on the web host.
APPRADAR_MIGRATION_DATABASE_URL=

# --- User authentication (Supabase Auth via @supabase/ssr) ---
# Project URL and the PUBLISHABLE key (sb_publishable_… or the legacy anon key). Safe for browsers.
# Never put the service-role / sb_secret_ key here: it is rejected at runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Absolute site origin used in email links and OAuth callbacks (https in production; required there).
# Example: https://appradar.example.com — locally http://127.0.0.1:3000 (optional in development).
NEXT_PUBLIC_SITE_URL=
# Google sign-in needs no variable here: the button appears only when the Google provider is
# enabled in the Supabase Dashboard (checked via the project's public /auth/v1/settings).
# APPRADAR_DEMO_MODE=true also bypasses sign-in, but only when NODE_ENV=development.

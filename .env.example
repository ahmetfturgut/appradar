# Gerçek anahtarları bu dosyaya eklemeyin. .env.local kullanın.
APIFY_TOKEN=
# Kullanıcı tarafından onaylanan toplam POC tüketim sınırı, USD.
POC_LIMIT_USD=5
# Gerçek çalışmayı açmak için ayrı olarak true yapılır; varsayılan dry-run.
APIFY_COLLECTION_ENABLED=false
# POC kapsamında saklama/inceleme hakkı doğrulanmadan canlı çekim açılmaz.
POC_DATA_USE_CONFIRMED=false
# POC tamamlanmadan aylık üretim toplaması açılmaz.
MONTHLY_LIMIT_USD=
DAILY_LIMIT_USD=

# Kalıcılık (T4–T7) yalnızca sunucuda kullanır; NEXT_PUBLIC_ ile yayınlamayın.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Okuma sunumu: ticari haklar doğrulanmadan kapalı kalır (true yapılmaz).
APPRADAR_STORE_MEDIA_ENABLED=false
APPRADAR_STORE_DESCRIPTION_ENABLED=false
APPRADAR_REVIEW_CONTENT_ENABLED=false

# Yalnızca NODE_ENV=development iken sentetik UI. Production bu bayrağı yok sayar.
APPRADAR_DEMO_MODE=false

# Retention cleanup (src/lib/retention/cli.ts) is a dry run unless this is true, --execute is passed
# and the policy file carries an approval. Nothing schedules it.
RETENTION_CLEANUP_EXECUTION=false

# Production only (required there, ignored in development): the ref of the ONE Supabase project this
# deployment may use, i.e. <ref> in https://<ref>.supabase.co. Both Supabase URLs must match it.
# In production the app answers 503 until this file's server and public values are complete and valid,
# and while APPRADAR_DEMO_MODE or any collection/retention flag is true. See docs/PRODUCTION.md.
APPRADAR_SUPABASE_PROJECT_REF=

# --- User authentication (Supabase Auth via @supabase/ssr) ---
# Project URL and the PUBLISHABLE key (sb_publishable_… or the legacy anon key). Safe for browsers.
# Never put the service-role / sb_secret_ key here: it is rejected at runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Absolute site origin used in email links and OAuth callbacks (https in production; required there).
# Example: https://appradar.example.com — locally http://127.0.0.1:3000 (optional in development).
NEXT_PUBLIC_SITE_URL=
# Google sign-in needs no variable here: the button appears only when the Google provider is
# enabled in the Supabase Dashboard (checked via the project's public /auth/v1/settings).
# APPRADAR_DEMO_MODE=true also bypasses sign-in, but only when NODE_ENV=development.
